# Postgres connection string. Leave empty locally to use the embedded PGlite database in .data/.
# On Vercel, adding a Neon database from the Storage tab sets DATABASE_URL for you.
DATABASE_URL=

# Signs the admin session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Admin login. The password needs at least 12 characters. `npm run db:seed` (run before `npm run dev`
# and on each Vercel build) creates this user, or resets its password to this value.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel Blob for image uploads. Leave empty locally to save uploads to .data/uploads/.
# On Vercel, connecting a Blob store from the Storage tab sets BLOB_READ_WRITE_TOKEN (older
# stores) or BLOB_STORE_ID (newer stores, which authenticate automatically). Either works.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
